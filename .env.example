APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://alkawthar.store

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file


PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alka_alkewthr
DB_USERNAME=
DB_PASSWORD=


Admin_Email=
Admin_Password=


SESSION_DRIVER=file
SESSION_LIFETIME=120
# SESSION_ENCRYPT=false
# SESSION_PATH=/
# SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379






MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="elkuther"


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


API_RATE_LIMIT=60

# Minutes until API tokens expire (default 30 days)
SANCTUM_EXPIRATION=43200

# Require current_password on POST /api/user/password/reset (enable after the app sends it)
PASSWORD_CHANGE_REQUIRES_CURRENT=false

# Admin dashboard and store clock (config/pharmacy.php)
# The store operates in Egypt only and uses EGP (fixed in config/pharmacy.php, not configurable).
PHARMACY_NAME=Alkawthar
PHARMACY_LOW_STOCK_THRESHOLD=5
# Egyptian local time, in which promotion and coupon dates are entered.
PHARMACY_TIMEZONE=Africa/Cairo
# Loyalty points are redeemable once the order is completed (false = from checkout).
PHARMACY_POINTS_REDEEM_REQUIRES_COMPLETION=true
# Supplier payments on account above what is owed, when ticked "advance payment".
PHARMACY_SUPPLIER_ADVANCE_PAYMENTS=true

# Paymob (online payments). Leave empty until the client's account is ready; Paymob stays unavailable.
PAYMOB_ENV=sandbox
PAYMOB_FLOW=intention
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_CHECKOUT_URL=https://eg.checkout.paymob.com/
PAYMOB_CURRENCY=EGP
PAYMOB_AMOUNT_FACTOR=1
PAYMOB_PAYMENT_TTL_MINUTES=60
PAYMOB_VERIFY_WITH_API=true
PAYMOB_RETURN_URL=elkawther://payment-result
PAYMOB_SANDBOX_API_KEY=
PAYMOB_SANDBOX_SECRET_KEY=
PAYMOB_SANDBOX_PUBLIC_KEY=
PAYMOB_SANDBOX_HMAC_SECRET=
PAYMOB_SANDBOX_INTEGRATION_IDS=
PAYMOB_SANDBOX_IFRAME_ID=
PAYMOB_SANDBOX_MERCHANT_ID=
PAYMOB_LIVE_API_KEY=
PAYMOB_LIVE_SECRET_KEY=
PAYMOB_LIVE_PUBLIC_KEY=
PAYMOB_LIVE_HMAC_SECRET=
PAYMOB_LIVE_INTEGRATION_IDS=
PAYMOB_LIVE_IFRAME_ID=
PAYMOB_LIVE_MERCHANT_ID=
